    {
      "parameters": {
        "jsCode": "// Turns each file into { source, text } so every chunk keeps its file name\nconst items = $input.all();\nconst docs = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const buffer = await this.helpers.getBinaryDataBuffer(i, 'data');\n  docs.push({\n    json: {\n      source: items[i].binary.data.fileName,\n      text: buffer.toString('utf8'),\n    },\n  });\n}\n\nreturn docs;"
      },
