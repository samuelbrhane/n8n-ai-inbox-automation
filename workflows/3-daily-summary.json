    {
      "parameters": {
        "jsCode": "// Builds today's report from the Inbox log rows\nconst today = $now.toFormat('yyyy-MM-dd');\nconst rows = $input.all()\n  .map(item => item.json)\n  .filter(row => String(row.handled_at || '').startsWith(today));\n\nconst count = (column, value) => rows.filter(row => row[column] === value).length;\nconst list = items => items.length\n  ? items.map(row => `• ${row.subject} (${row.from})`).join('\\n')\n  : '• none';\n\nconst types = ['question', 'repair', 'complaint', 'viewing', 'spam']\n  .map(type => `• ${type}: ${count('category', type)}`)\n  .join('\\n');\n\nconst emergencies = rows.filter(row => row.urgency === 'emergency');\nconst waiting = rows.filter(row => row.status === 'escalated' || row.status === 'rejected');\n\nconst text = [\n  `:bar_chart: *Daily summary, ${today}*`,\n  `*${rows.length} emails handled*`,\n  types,\n  '',\n  `*Replies sent after approval:* ${count('status', 'sent')}`,\n  `*Automatic replies:* ${count('status', 'auto_replied')}`,\n  '',\n  `:rotating_light: *Emergencies:* ${emergencies.length}`,\n  list(emergencies),\n  '',\n  `:raising_hand: *Waiting for a person:* ${waiting.length}`,\n  list(waiting),\n].join('\\n');\n\nreturn [{ json: { text } }];"
      },
