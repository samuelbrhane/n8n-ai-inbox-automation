      "parameters": {
        "jsCode": "// Joins all free slots into one text block for the reply email\nconst slots = $input.all()\n  .map(item => item.json)\n  .filter(slot => slot.flat);\n\nconst lines = slots.map(\n  slot => `- ${slot.date} at ${slot.time}: ${slot.address} (flat ${slot.flat})`\n);\n\nreturn [{\n  json: {\n    count: slots.length,\n    slots_text: lines.join('\\n'),\n  },\n}];"
      },
